        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Usuario {\n        +UUID id\n        +String nome\n        +String email\n        +String senhaHash\n        +TipoUsuario tipo\n        +DateTime criadoEm\n        +autenticar(senha): Boolean\n    }\n\n    class TipoUsuario {\n        &lt;&lt;enumeration&gt;&gt;\n        ALUNO\n        PROFESSOR\n    }\n\n    class Fase {\n        +UUID id\n        +String nome\n        +Int numero\n    }\n\n    class Materia {\n        +UUID id\n        +String nome\n        +String codigo\n    }\n\n    class Postagem {\n        +UUID id\n        +String titulo\n        +String conteudo\n        +String urlImagem\n        +TipoPostagem tipo\n        +DateTime criadoEm\n        +adicionarComentario(comentario)\n        +curtir(usuario)\n    }\n\n    class TipoPostagem {\n        &lt;&lt;enumeration&gt;&gt;\n        DUVIDA\n        MATERIAL_ESTUDO\n    }\n\n    class Comentario {\n        +UUID id\n        +String conteudo\n        +DateTime criadoEm\n        +curtir(usuario)\n    }\n\n    class CurtidaPostagem {\n        +UUID id\n        +DateTime criadoEm\n    }\n\n    class CurtidaComentario {\n        +UUID id\n        +DateTime criadoEm\n    }\n\n    %% Relacionamentos\n    Usuario \&quot;1\&quot; -- \&quot;0..*\&quot; Postagem : publica &gt;\n    Usuario \&quot;1\&quot; -- \&quot;0..*\&quot; Comentario : escreve &gt;\n    Usuario \&quot;1\&quot; -- \&quot;0..*\&quot; CurtidaPostagem : realiza &gt;\n    Usuario \&quot;1\&quot; -- \&quot;0..*\&quot; CurtidaComentario : realiza &gt;\n\n    Fase \&quot;1\&quot; -- \&quot;0..*\&quot; Postagem : categoriza &gt;\n    Materia \&quot;1\&quot; -- \&quot;0..*\&quot; Postagem : pertence_a &gt;\n    Materia \&quot;*\&quot; -- \&quot;*\&quot; Fase : vinculada_a\n\n    Postagem \&quot;1\&quot; *-- \&quot;0..*\&quot; Comentario : possui &gt;\n    Postagem \&quot;1\&quot; *-- \&quot;0..*\&quot; CurtidaPostagem : recebe &gt;\n    Comentario \&quot;1\&quot; *-- \&quot;0..*\&quot; CurtidaComentario : recebe &gt;\n    Usuario \&quot;1\&quot; -- \&quot;1\&quot; TipoUsuario : possui\n    Postagem \&quot;1\&quot; -- \&quot;1\&quot; TipoPostagem : possui&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="SaBFZeQnZ0-7io4bVYe_-1">
